# Copy to .env for local use, or set these in the deployment secret manager.
# Placeholders are intentional. NEVER commit real credentials.
#
#   cp server/.env.example server/.env
#   npm run doctor        # checks everything below and names what is missing
#
# npm run doctor exits 0 only when a real payment would succeed, and runs the
# same checks as GET /api/admin/payment-status on the deployed server.
PORT=8787
# The public origin Razorpay calls back to. On a deployment set this to the real
# domain; localhost is only correct for local testing.
PUBLIC_BASE_URL=http://localhost:8787
PROVIDER_TIMEOUT_MS=15000

# Razorpay Dashboard → Settings → API Keys / Webhooks
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=choose_a_long_random_webhook_secret

# Local non-production demo only. Demo also requires Razorpay keys to be unset.
# Keep disabled and set NODE_ENV=production in the live deployment.
TL_DEMO_MODE=0

# Optional durable file for ONE long-running Node instance.
# Use an absolute, backed-up path. Serverless production requires Supabase instead.
TL_DATA_FILE=

# Supabase Cloud PostgreSQL. Run the entire server/schema.sql first.
# The service key is server-only; never expose it in the extension or pricing page.
# This must be the service_role key: the anon key cannot write licences, so
# checkout would fail with a permission error. It bypasses row-level security,
# which is exactly why it must never reach a browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Resend transactional email. Use a verified sender/domain in production.
RESEND_API_KEY=
RESEND_FROM=Trade Lock <licenses@your-verified-domain.example>

# ---------------------------------------------------------------- Market data ----
# RECOMMENDED: Upstox Analytics Token.
# Free, read-only, generated once at Upstox Developer Apps -> Analytics,
# valid for a full year, and covers candles + quotes + option chain.
# It cannot place orders, so it is safe to keep on a server.
# This is the credential that removes the daily-refresh problem entirely.
UPSTOX_ANALYTICS_TOKEN=

# Optional alternative: Fyers API v3 (Pro+ live routes).
# WARNING: the Fyers access token expires every day at 06:30 IST. Without a
# human pasting a new token each trading morning, Pro+ live data goes dark.
# Upstox (above) is preferred and takes priority when both are set.
FYERS_APP_ID=
FYERS_SECRET=
FYERS_REDIRECT_URL=https://your-server.example/api/fyers/callback-page
FYERS_ACCESS_TOKEN=
# Guards EVERY /api/admin/* route: payment-status, market-status, market-token,
# OAuth helpers, and licence reissue. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Anyone with this token can read revenue and change feed state. Treat it as a
# password and do not reuse it as another key.
FYERS_ADMIN_TOKEN=

# Optional remote narration. Local deterministic briefs are used without these.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# ------------------------------------------------------------ Optional tuning ----
# Endpoint overrides. The defaults are the public production endpoints; change
# these only to point at a mock server or a proxy.
# FYERS_AUTH_BASE=
# FYERS_DATA_BASE=
# UPSTOX_BASE=
# SUPABASE_KEY=            # legacy alias for SUPABASE_SERVICE_KEY

# Market feed cache and provider call timeouts, in milliseconds.
# MARKET_CACHE_TTL_MS=45000
# MARKET_CACHE_MAX=
