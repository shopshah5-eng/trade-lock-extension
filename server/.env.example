# Copy to .env (or set as environment variables on your host) — NEVER commit real keys.
PORT=8787

# Razorpay Dashboard → Settings → API Keys (use Test keys first, then Live)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay Dashboard → Settings → Webhooks (secret you choose when creating it)
RAZORPAY_WEBHOOK_SECRET=choose_a_long_random_string

# Local testing only: issues clearly-marked demo license keys with NO payment.
# NEVER set this in production.
TL_DEMO_MODE=0

# --- Market intelligence (Pro+ AI Markets) ---
# Fyers API app (Dashboard → My APIs). Secret + tokens live ONLY here.
FYERS_APP_ID=
FYERS_SECRET=
[SECURITY_DATA]
# A current access token for single-user/self-hosted mode (OAuth flow also supported)
FYERS_ACCESS_TOKEN=
[SECURITY_DATA]
# OpenRouter (optional — without it, briefs are generated locally)
OPENROUTER_API_KEY=

# Google Gemini API
GEMINI_API_KEY=

# Transactional Emails (Resend)
RESEND_API_KEY=
RESEND_FROM=Trade Lock <onboarding@resend.dev>

# Supabase Cloud Database (trade-lock)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

PUBLIC_BASE_URL=http://localhost:8787
