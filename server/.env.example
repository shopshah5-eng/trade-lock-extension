# Copy to .env for local use, or set these in the deployment secret manager.
# Placeholders are intentional. NEVER commit real credentials.
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
PROVIDER_TIMEOUT_MS=15000

# Razorpay Dashboard → Settings → API Keys / Webhooks
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=choose_a_long_random_webhook_secret

# Local non-production demo only. Demo also requires Razorpay keys to be unset.
# Keep disabled and set NODE_ENV=production in the live deployment.
TL_DEMO_MODE=0

# Optional durable file for ONE long-running Node instance.
# Use an absolute, backed-up path. Serverless production requires Supabase instead.
TL_DATA_FILE=

# Supabase Cloud PostgreSQL. Run the entire server/schema.sql first.
# The service key is server-only; never expose it in the extension or pricing page.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Resend transactional email. Use a verified sender/domain in production.
RESEND_API_KEY=
RESEND_FROM=Trade Lock <licenses@your-verified-domain.example>

# Fyers market data (Pro+ live routes). Tokens and secrets stay server-side.
FYERS_APP_ID=
FYERS_SECRET=
FYERS_REDIRECT_URL=https://your-server.example/api/fyers/callback-page
FYERS_ACCESS_TOKEN=
# Separate secret required only for the protected OAuth admin helper routes.
FYERS_ADMIN_TOKEN=

# Optional remote narration. Local deterministic briefs are used without these.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
