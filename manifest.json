{
  "manifest_version": 3,
  "name": "Trade Lock — daily trading discipline",
  "version": "1.0.0",
  "description": "Daily trading discipline guard and journal. Locks broker access when your trade count, loss limit, or risk budget is reached.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "declarativeNetRequest",
    "scripting",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "options/options.html"
  },
  "host_permissions": [
    "https://trade-lock-app.netlify.app/*",
    "https://*.kite.zerodha.com/*",
    "https://*.zerodha.com/*",
    "https://*.kitecharts.com/*",
    "https://*.upstox.com/*",
    "https://*.angelone.in/*",
    "https://*.angelbroking.com/*",
    "https://*.dhan.co/*",
    "https://*.5paisa.com/*",
    "https://*.fyers.in/*",
    "https://*.groww.in/*",
    "https://*.sahi.com/*",
    "https://*.shoonya.com/*",
    "https://*.finvasia.com/*",
    "https://*.kotakneo.com/*",
    "https://*.kotaksecurities.com/*",
    "https://*.paytmmoney.com/*",
    "https://*.icicidirect.com/*",
    "https://*.hdfcsky.com/*",
    "https://*.aliceblueonline.com/*",
    "https://*.sharekhan.com/*",
    "https://*.myespresso.com/*",
    "https://*.motilaloswal.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.kite.zerodha.com/*",
        "https://*.zerodha.com/*",
        "https://*.kitecharts.com/*",
        "https://*.upstox.com/*",
        "https://*.angelone.in/*",
        "https://*.angelbroking.com/*",
        "https://*.dhan.co/*",
        "https://*.5paisa.com/*",
        "https://*.fyers.in/*",
        "https://*.groww.in/*",
        "https://*.sahi.com/*",
        "https://*.shoonya.com/*",
        "https://*.finvasia.com/*",
        "https://*.kotakneo.com/*",
        "https://*.kotaksecurities.com/*",
        "https://*.paytmmoney.com/*",
        "https://*.icicidirect.com/*",
        "https://*.hdfcsky.com/*",
        "https://*.aliceblueonline.com/*",
        "https://*.sharekhan.com/*",
        "https://*.myespresso.com/*",
        "https://*.motilaloswal.com/*"
      ],
      "js": [
        "lib/rules.js",
        "lib/detector.js",
        "lib/market.js",
        "content/lock.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/lock.html",
        "content/lockpage.js"
      ],
      "matches": [
        "https://*.kite.zerodha.com/*",
        "https://*.zerodha.com/*",
        "https://*.kitecharts.com/*",
        "https://*.upstox.com/*",
        "https://*.angelone.in/*",
        "https://*.angelbroking.com/*",
        "https://*.dhan.co/*",
        "https://*.5paisa.com/*",
        "https://*.fyers.in/*",
        "https://*.groww.in/*",
        "https://*.sahi.com/*",
        "https://*.shoonya.com/*",
        "https://*.finvasia.com/*",
        "https://*.kotakneo.com/*",
        "https://*.kotaksecurities.com/*",
        "https://*.paytmmoney.com/*",
        "https://*.icicidirect.com/*",
        "https://*.hdfcsky.com/*",
        "https://*.aliceblueonline.com/*",
        "https://*.sharekhan.com/*",
        "https://*.myespresso.com/*",
        "https://*.motilaloswal.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Trade Lock"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
